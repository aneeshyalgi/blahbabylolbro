# Development Dockerfile for Frontend
FROM node:20-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache libc6-compat

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy application code
COPY . .

EXPOSE 3000

# Run development server
CMD ["npm", "run", "dev"]
